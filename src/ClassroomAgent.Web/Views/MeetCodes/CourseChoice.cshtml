@using System.Globalization
@using ClassroomAgent.Application.Models.Dtos
@model MeetCodeCourseChoicePageModel
@{
    ViewData["Title"] = T[MeetCodesTextKeys.ChoiceTitle];

    // Api-design §2.11: the code is in the path; the query carries only the validated returnPage.
    ViewData[UiLanguageController.ReturnPathViewDataKey] =
        SignInRoutes.MeetCodes + "/" + Uri.EscapeDataString(Model.MeetingCode) + "/course-choice?"
        + MeetCodesController.ReturnPageParameter + "=" + Model.ReturnPage.ToString(CultureInfo.InvariantCulture)
        + (Model.ReturnQ is { } returnQ ? "&" + MeetCodesController.ReturnQParameter + "=" + Uri.EscapeDataString(returnQ) : string.Empty);
    var state = Model.CurrentState.ToString().ToLowerInvariant();
}

<p id="meet-code">@Model.MeetingCode</p>

@if (Model.FieldError is { } fieldError)
{
    <p id="meet-codes-field-error" class="form-error">@T[MeetCodesTextKeys.FieldError(fieldError)]</p>
}

@if (Model.CurrentCourse is { } current)
{
    <p id="meet-code-current-course">@T[MeetCodesTextKeys.ChoiceCurrent]: @CourseLabel(current)@Mark(current.Id)</p>
}

@{
    void FormBody()
    {
        <text>
        @Html.AntiForgeryToken()
        <input type="hidden" name="expectedState" value="@state" />
        @if (Model.CurrentState == MeetCodeExpectedState.Linked && Model.CurrentCourse is { } linked)
        {
            <input type="hidden" name="expectedCourseId" value="@linked.Id.ToString(CultureInfo.InvariantCulture)" />
        }
        <input type="hidden" name="returnPage" value="@Model.ReturnPage.ToString(CultureInfo.InvariantCulture)" />
        @if (Model.ReturnQ is not null)
        {
            <input type="hidden" name="@MeetCodesController.ReturnQParameter" value="@Model.ReturnQ" />
        }

        @if (Model.Candidates.Count > 0)
        {
            <fieldset>
                <legend>@T[MeetCodesTextKeys.ChoiceCandidates]</legend>
                @foreach (var candidate in Model.Candidates)
                {
                    <p data-narrow-row data-narrow-text="@CourseLabel(candidate.Course)">
                        <label class="form-check">
                            <input type="radio" name="courseId" value="@candidate.Course.Id.ToString(CultureInfo.InvariantCulture)" required class="form-check-input" />
                            @CourseLabel(candidate.Course) (@candidate.SharePercent.ToString(CultureInfo.InvariantCulture)%)
                        </label>
                    </p>
                }
            </fieldset>
        }

        @if (Model.OtherCourses.Count > 0)
        {
            <fieldset>
                <legend>@T[MeetCodesTextKeys.ChoiceOtherCourses]</legend>
                @foreach (var course in Model.OtherCourses)
                {
                    <p data-narrow-row data-narrow-text="@CourseLabel(course)">
                        <label class="form-check">
                            <input type="radio" name="courseId" value="@course.Id.ToString(CultureInfo.InvariantCulture)" required class="form-check-input" />
                            @CourseLabel(course)@Mark(course.Id)
                        </label>
                    </p>
                }
            </fieldset>
        }

        <button type="submit" id="meet-code-choice-submit" class="btn btn-primary">@T[MeetCodesTextKeys.ChoiceSubmit]</button>
        <a href="@CancelUrl()">@T[MeetCodesTextKeys.ChoiceCancel]</a>
        </text>
    }
}

@if (Model.Candidates.Count > 0 || Model.OtherCourses.Count > 0)
{
    <form id="meet-code-choice-form" method="post" action="@(SignInRoutes.MeetCodes + "/" + Uri.EscapeDataString(Model.MeetingCode) + "/link")" data-narrow="radios" data-narrow-label="@T[PickerTextKeys.Label]" data-narrow-none="@T[PickerTextKeys.NothingFound]">
        @{ FormBody(); }
    </form>
    <script src="~/js/picker-narrow.js" asp-append-version="true"></script>
}
else
{
    <form id="meet-code-choice-form" method="post" action="@(SignInRoutes.MeetCodes + "/" + Uri.EscapeDataString(Model.MeetingCode) + "/link")">
        @{ FormBody(); }
    </form>
}

@functions {
    /// <summary>US-070 FR-005: back to the list the choice was opened from, with its search text and page.</summary>
    private string CancelUrl() =>
        SignInRoutes.MeetCodes + "?" + MeetCodesController.ListParameter + "=" + MeetCodesController.ListText(Model.CurrentList)
        + (Model.ReturnQ is { } q ? "&" + MeetCodesController.SearchParameter + "=" + Uri.EscapeDataString(q) : string.Empty)
        + "&" + MeetCodesController.PageParameter + "=" + Model.ReturnPage.ToString(CultureInfo.InvariantCulture);

    /// <summary>US-061 spec FR-003.2, OD-002 a: a marked course's mark with its date after its name; nothing for others.</summary>
    private string Mark(long courseId) =>
        Model.Absences.TryGetValue(courseId, out var absence) ? " (" + DataMarksTexts.Absence(T, absence) + ")" : string.Empty;

    /// <summary>Spec I-7: the course name, then its section when it has one; Google data, not translated.</summary>
    private static string CourseLabel(CourseOption course) =>
        string.IsNullOrEmpty(course.Section) ? course.Name : course.Name + " — " + course.Section;
}
