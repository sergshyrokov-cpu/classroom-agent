@using ClassroomAgent.Domain.Enums
@model WorkspaceConnectionPageModel
@{
    ViewData["Title"] = T[WorkspaceConnectionTextKeys.Title];
}

@if (Model.IsReadOnly)
{
    <section class="notice">
        <h2>@T["Landing.ReadOnly.Title"]</h2>
        <p>@T[ReasonKey(Model.ReadOnlyReason)]</p>
    </section>
}

<p>
    @T[WorkspaceConnectionTextKeys.DomainLabel]:
    <span id="installation-domain">@(Model.InstallationDomain ?? T[WorkspaceConnectionTextKeys.DomainUnknown].Value)</span>
</p>

<p id="connection-state">@T[StateKey(Model.State)]</p>

@{
    var last = Model.LastSynchronization;
}
<section id="last-synchronization">
    <h2>@T["LastSync.Title"]</h2>
    <p id="last-synchronization-status">@T[LastSyncStatusKey(last.Status)]</p>
    @if (last.Status == LastSynchronizationStatus.Failed && last.Diagnosis is { } diagnosis)
    {
        <p id="last-synchronization-diagnosis">@T[LastSyncDiagnosisKey(diagnosis)]</p>
    }
    @if (last.Status == LastSynchronizationStatus.Running && last.StartedAt is { } startedAt)
    {
        <p>@T["LastSync.StartedAt"]: @FormatInstant(startedAt)</p>
    }
    else if (last.FinishedAt is { } finishedAt)
    {
        <p>@T["LastSync.FinishedAt"]: @FormatInstant(finishedAt)</p>
    }
    @if (last.Status != LastSynchronizationStatus.NeverRun)
    {
        if (last.LastSuccessfulRunAt is { } lastSuccess)
        {
            <p>@T["LastSync.LastSuccess"]: @FormatInstant(lastSuccess)</p>
        }
        else
        {
            <p>@T["LastSync.LastSuccess.None"]</p>
        }
    }
    else
    {
        <p>@T["LastSync.LastSuccess.None"]</p>
    }
</section>

@* US-019 spec FR-004: the Admin's button, next to the block it refreshes; shown in read-only mode too (OD-006). *@
@if (Model.SynchronizationMessageKey is { } synchronizationMessage)
{
    <p id="synchronization-request-message" class="form-message">@T[synchronizationMessage]</p>
}
<form id="synchronization-request-form" method="post" action="@SignInRoutes.SynchronizationRequests">
    @Html.AntiForgeryToken()
    <button type="submit">@T[SynchronizationRequestTextKeys.Button]</button>
</form>

@if (Model.SavedImpersonationUserEmail is { } saved)
{
    <p id="saved-impersonation-user">@saved</p>
}

@if (Model.MessageKey is not null)
{
    <p class="form-message">@T[Model.MessageKey]</p>
}

@foreach (var error in Model.FieldErrorKeys)
{
    <p class="form-error">@T[error]</p>
}

<p>@T[WorkspaceConnectionTextKeys.TechnicalAccountHint]</p>
<p>@T[WorkspaceConnectionTextKeys.CheckAccessHint]</p>

<form method="post" action="@SignInRoutes.WorkspaceConnection">
    @Html.AntiForgeryToken()
    <label for="impersonationUserEmail">@T[WorkspaceConnectionTextKeys.ImpersonationUserLabel]</label>
    <input type="email"
           id="impersonationUserEmail"
           name="impersonationUserEmail"
           value="@Model.TypedImpersonationUserEmail" />
    <button type="submit">@T[WorkspaceConnectionTextKeys.SaveButton]</button>
</form>

@functions {
    /// <summary>As the landing page shows the last legitimacy check: the request culture's short date, HH:mm, UTC.</summary>
    private static string FormatInstant(DateTimeOffset instant) =>
        instant.UtcDateTime.ToString(
            System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern + " HH:mm",
            System.Globalization.CultureInfo.CurrentCulture) + " UTC";

    private static string LastSyncStatusKey(LastSynchronizationStatus status) => "LastSync.Status." + status;

    /// <summary>The six configuration outcomes reuse the "Check access" text (spec FR-007, OD-006).</summary>
    private static string LastSyncDiagnosisKey(SyncDiagnosis diagnosis) => diagnosis switch
    {
        SyncDiagnosis.GoogleUnavailable => "LastSync.Diagnosis.GoogleUnavailable",
        SyncDiagnosis.Unexpected => "LastSync.Diagnosis.Unexpected",
        _ => "AccessCheck.Outcome." + diagnosis,
    };

    private static string ReasonKey(LegitimacyModeReason? reason) => reason switch
    {
        LegitimacyModeReason.NotYetConfirmed => "Landing.ReadOnly.NotYetConfirmed",
        LegitimacyModeReason.SuspendedByOwner => "Landing.ReadOnly.SuspendedByOwner",
        LegitimacyModeReason.GracePeriodExpired => "Landing.ReadOnly.GracePeriodExpired",
        _ => "Landing.ReadOnly.Title",
    };

    private static string StateKey(WorkspaceConnectionState state) => state switch
    {
        WorkspaceConnectionState.Configured => WorkspaceConnectionTextKeys.StateConfigured,
        WorkspaceConnectionState.DomainMismatch => WorkspaceConnectionTextKeys.StateDomainMismatch,
        _ => WorkspaceConnectionTextKeys.StateNotConfigured,
    };
}
