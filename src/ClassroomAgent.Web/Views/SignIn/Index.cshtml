@model SignInPageModel
@{
    ViewData["Title"] = T["SignIn.Title"];
}
@if (Model.RefusalKey is not null)
{
    <p class="form-error">@T[Model.RefusalKey]</p>
}
<form method="post" action="@SignInRoutes.Start">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-primary">@T["SignIn.Google.Button"]</button>
</form>

<form method="post" action="/sign-in" id="dean-sign-in">
    @Html.AntiForgeryToken()
    <label class="form-label">
        @T[DeanAccountTextKeys.SignInEmailLabel]
        <input type="email" name="email" autocomplete="username" class="form-control" />
    </label>
    <label class="form-label">
        @T[DeanAccountTextKeys.SignInPasswordLabel]
        <span class="password-field">
            <input type="password" name="password" autocomplete="current-password" spellcheck="false" autocapitalize="off" class="form-control" />
            @await Html.PartialAsync("_PasswordToggle")
        </span>
    </label>
    <button type="submit" class="btn btn-primary">@T[DeanAccountTextKeys.SignInSubmit]</button>
</form>
<script src="/js/password-toggle.js" defer></script>
