@inject DataHealthBanner DataHealth
@{
    // US-062 FR-003, api-design §2.3: computed once per page; null renders nothing (I-4, OD-001 a).
    var dataHealth = await DataHealth.ForAsync(Context);
    var helpPage = PageHelpTextKeys.PageOf(ViewData[PageHelpTextKeys.ViewDataKey]);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @T["Layout.AppName"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="page-header container">
        @await Html.PartialAsync("_LanguageSwitcher")
        @await Html.PartialAsync("_HeaderSearch")
        @if (dataHealth is { } counts)
        {
            @* US-062 FR-003.3: a restrained coloured strip. US-075 FR-001: each non-zero part links to its own section of
               «Стан даних»; a zero part is plain text; the separator of DataHealth.Banner ("{0}, {1}") stays outside the links. *@
            var bannerFormat = T[DataHealthTextKeys.Banner].Value;
            var technicalAt = bannerFormat.IndexOf("{0}", StringComparison.Ordinal);
            var teachingAt = bannerFormat.IndexOf("{1}", StringComparison.Ordinal);
            @* US-075 R-1 (HUMAN_PR_APPROVAL): the separator's punctuation (the comma) stays glued to the end of the first part,
               outside its link, so a wrap happens only at the separator's space. *@
            var separator = bannerFormat[(technicalAt + 3)..teachingAt];
            var separatorGlue = separator.TrimEnd();
            <p id="data-health-banner" class="data-health-banner">@bannerFormat[..technicalAt]<span class="data-health-banner-lead">@BannerPart("Technical", counts.TechnicalCount, "data-health-technical")@separatorGlue</span>@separator[separatorGlue.Length..]@BannerPart("Teaching", counts.TeachingCount, "data-health-teaching")@bannerFormat[(teachingAt + 3)..]</p>
        }
    </header>
    <main class="page container">
        @* US-076 FR-004, VR-001: on the five pages that name their page id the title and the help form one title block;
           a missing or unknown id renders the plain title, as on every other page. *@
        @if (helpPage is not null)
        {
            @:<div class="page-title">
        }
        <h1>@ViewData["Title"]</h1>
        @if (helpPage is not null)
        {
            @await Html.PartialAsync("_PageHelp", helpPage)
            @:</div>
        }
        @RenderBody()
    </main>
</body>
</html>
@functions {
    /// <summary>US-075 FR-001.2 … FR-001.5: one banner part — a no-wrap link to its section when above zero, plain text at zero.</summary>
    private Microsoft.AspNetCore.Html.IHtmlContent BannerPart(string part, int count, string section)
    {
        var text = T[DataHealthTextKeys.BannerPart(part, count), count].Value;
        if (count == 0)
        {
            return new Microsoft.AspNetCore.Html.HtmlContentBuilder().Append(text);
        }

        var link = new Microsoft.AspNetCore.Mvc.Rendering.TagBuilder("a");
        link.AddCssClass("data-health-banner-part");
        link.Attributes["href"] = SignInRoutes.DataHealth + "#" + section;
        link.InnerHtml.Append(text);
        return link;
    }
}
