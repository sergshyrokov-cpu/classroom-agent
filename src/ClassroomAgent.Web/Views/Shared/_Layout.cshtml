@inject DataHealthBanner DataHealth
@{
    // US-062 FR-003, api-design §2.3: computed once per page; null renders nothing (I-4, OD-001 a).
    var dataHealth = await DataHealth.ForAsync(Context);
    var helpPage = PageHelpTextKeys.PageOf(ViewData[PageHelpTextKeys.ViewDataKey]);
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @T["Layout.AppName"]</title>
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="page-header container">
        @await Html.PartialAsync("_LanguageSwitcher")
        @await Html.PartialAsync("_HeaderSearch")
        @if (dataHealth is { } counts)
        {
            @* FR-003.2, FR-003.3: a restrained coloured strip; its whole text is one link to «Стан даних». *@
            <p id="data-health-banner" class="data-health-banner"><a href="@SignInRoutes.DataHealth">@T[DataHealthTextKeys.Banner, T[DataHealthTextKeys.BannerPart("Technical", counts.TechnicalCount), counts.TechnicalCount], T[DataHealthTextKeys.BannerPart("Teaching", counts.TeachingCount), counts.TeachingCount]]</a></p>
        }
    </header>
    <main class="page container">
        @* US-076 FR-004, VR-001: on the five pages that name their page id the title and the help form one title block;
           a missing or unknown id renders the plain title, as on every other page. *@
        @if (helpPage is not null)
        {
            @:<div class="page-title">
        }
        <h1>@ViewData["Title"]</h1>
        @if (helpPage is not null)
        {
            @await Html.PartialAsync("_PageHelp", helpPage)
            @:</div>
        }
        @RenderBody()
    </main>
</body>
</html>
