@model string
@* US-046 api-design §3: one leaf line, its text from the translation files and HTML-encoded (spec FR-008, S-03). *@
@{
    var key = PageSearchHintTextKeys.FieldLabelKey(Model);
}
<p id="page-search-hint" class="page-search-hint" data-variant="@Model">@(key is null ? T[PageSearchHintTextKeys.OrdinaryText, T[SearchTextKeys.FieldLabel].Value] : T[PageSearchHintTextKeys.ListFieldText, T[key].Value, T[SearchTextKeys.FieldLabel].Value])</p>
