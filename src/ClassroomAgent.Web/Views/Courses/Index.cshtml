@using System.Globalization
@using ClassroomAgent.Application.Models.Dtos
@using ClassroomAgent.Application.UseCases
@using ClassroomAgent.Domain.Enums
@model CourseListPageModel
@{
    ViewData["Title"] = T[CoursesTextKeys.Title];

    // Spec FR-009: the language switcher returns to the effective query, never the raw one.
    ViewData[UiLanguageController.ReturnPathViewDataKey] = Model.ReturnPath;

    void TeacherOptions()
    {
        <text>
            <option value="">@T[CoursesTextKeys.FormAllTeachers]</option>
            @foreach (var teacher in Model.TeacherChoice)
            {
                <option value="@teacher.ParticipantId.ToString(CultureInfo.InvariantCulture)" selected="@(teacher.ParticipantId == Model.SelectedTeacherId)">@TeacherLabel(teacher)</option>
            }
        </text>
    }
}

@await Html.PartialAsync("_PageSearchHint", PageSearchHintTextKeys.CourseList)

@foreach (var message in Model.MessageKeys)
{
    <p class="form-error">@T[CoursesTextKeys.Validation(message)]</p>
}

<form id="course-list-form" method="get" action="@SignInRoutes.Courses">
    <p>
        <label for="course-list-status" class="form-label">@T[CoursesTextKeys.FormStatus]</label>
        <select id="course-list-status" name="@CoursesController.StatusParameter" class="form-select">
            @foreach (var status in Enum.GetValues<CourseStatusFilter>())
            {
                <option value="@status.ToString().ToLowerInvariant()" selected="@(status == Model.Status)">@T[CoursesTextKeys.Status(status)]</option>
            }
        </select>
    </p>
    <p>
        <label for="course-list-teacher" class="form-label">@T[CoursesTextKeys.FormTeacher]</label>
        @if (Model.TeacherChoice.Count > 0)
        {
            <select id="course-list-teacher" name="@CoursesController.TeacherIdParameter" class="form-select" data-narrow="select" data-narrow-label="@T[PickerTextKeys.Label]" data-narrow-none="@T[PickerTextKeys.NothingFound]">
                @{ TeacherOptions(); }
            </select>
        }
        else
        {
            <select id="course-list-teacher" name="@CoursesController.TeacherIdParameter" class="form-select">
                @{ TeacherOptions(); }
            </select>
        }
    </p>
    <p>
        <label for="course-list-search" class="form-label">@T[CoursesTextKeys.FormSearch]</label>
        <input id="course-list-search" type="search" name="@CoursesController.SearchParameter" value="@Model.SearchText" maxlength="100" autocomplete="off" class="form-control" />
    </p>
    <button type="submit" class="btn btn-primary">@T[CoursesTextKeys.FormSubmit]</button>
</form>
@if (Model.TeacherChoice.Count > 0)
{
    <script src="~/js/picker-narrow.js"></script>
}

@if (Model.List is { } list)
{
    if (list.EmptyState is { } empty)
    {
        <p id="course-list-empty">@T[CoursesTextKeys.Empty(empty)]</p>
    }
    else
    {
        <p id="course-list-total">@T[CoursesTextKeys.PagingTotal, list.TotalCount]</p>
        <div class="table-scroll">
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th scope="col">@T[CoursesTextKeys.ColumnName]</th>
                        <th scope="col">@T[CoursesTextKeys.ColumnStatus]</th>
                        <th scope="col">@T[CoursesTextKeys.ColumnTeachers]</th>
                        <th scope="col" class="text-end">@T[CoursesTextKeys.ColumnStudents]</th>
                        <th scope="col" class="text-end">@T[CoursesTextKeys.ColumnUpdatedAt]</th>
                        <th scope="col">@T[CoursesTextKeys.ColumnLinks]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in list.Rows)
                    {
                        var id = row.CourseId.ToString(CultureInfo.InvariantCulture);
                        <tr data-course-id="@id">
                            <td>
                                <a href="@(SignInRoutes.Courses + "/" + id)">@row.Name</a>
                                @if (row.Section is not null)
                                {
                                    <br /><span>@row.Section</span>
                                }
                            </td>
                            <td>@T[CoursesTextKeys.State(row.State)]@if (row.Absence is { } absence) {<br /><span>@DataMarksTexts.Absence(T, absence)</span>}</td>
                            <td>
                                @* US-060 spec FR-002: in place of the teachers when none is on the roster. *@
                                @if (row.NoTeacherInClassroom)
                                {
                                    <div>@T[DataMarksTextKeys.NoTeacher]</div>
                                }
                                @foreach (var teacher in row.Teachers)
                                {
                                    <div>@PersonText(teacher)</div>
                                }
                            </td>
                            <td class="text-end">@row.StudentCount.ToString(CultureInfo.InvariantCulture)</td>
                            <td class="text-end">@row.UpdatedAt?.ToString(CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern + " HH:mm", CultureInfo.CurrentCulture)</td>
                            <td>
                                <a href="@(SignInRoutes.Journal + "?" + JournalController.CourseIdParameter + "=" + id)">@T[CoursesTextKeys.LinkJournal]</a>
                                <a href="@(SignInRoutes.MeetReports + "?" + MeetReportsController.CourseIdParameter + "=" + id)">@T[CoursesTextKeys.LinkMeetReports]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    if (list.PageCount > 1)
    {
        <nav id="course-list-paging">
            @if (list.Page > 1)
            {
                <a href="@PageUrl(list.Page - 1)">@T[CoursesTextKeys.PagingPrevious]</a>
            }
            @for (var n = 1; n <= list.PageCount; n++)
            {
                if (n == list.Page)
                {
                    <span>@n.ToString(CultureInfo.InvariantCulture)</span>
                }
                else
                {
                    <a href="@PageUrl(n)">@n.ToString(CultureInfo.InvariantCulture)</a>
                }
            }
            @if (list.Page < list.PageCount)
            {
                <a href="@PageUrl(list.Page + 1)">@T[CoursesTextKeys.PagingNext]</a>
            }
        </nav>
    }
}

@functions {
    /// <summary>Spec FR-007: the name, or the translated "no name" text; Google data is not translated.</summary>
    private string PersonText(CourseListPersonName name) =>
        name.Kind == CourseListPersonNameKind.NoName ? T[CoursesTextKeys.TeacherNoName].Value : name.Text ?? string.Empty;

    /// <summary>Spec FR-005: the name, then the email only when the option needs disambiguating.</summary>
    private string TeacherLabel(TeacherOption option) =>
        option.DisambiguatingEmail is null ? PersonText(option.Name) : PersonText(option.Name) + " (" + option.DisambiguatingEmail + ")";

    /// <summary>Spec FR-009: every paging link carries the effective filter.</summary>
    private string PageUrl(int page) => CourseListUrl.Build(Model.Status, Model.SelectedTeacherId, Model.SearchText, page);
}
