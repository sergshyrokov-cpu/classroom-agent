@model DeanAccountsPageModel
@{
    ViewData["Title"] = T[DeanAccountTextKeys.Title];
}

@if (Model.IsReadOnly)
{
    <section class="notice">
        <h2>@T["Landing.ReadOnly.Title"]</h2>
        <p>@T[ReasonKey(Model.ReadOnlyReason)]</p>
    </section>
}

@if (Model.MessageKey is not null)
{
    <p class="form-message">@T[Model.MessageKey]</p>
}

<table id="dean-accounts" class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>@T[DeanAccountTextKeys.ColumnEmail]</th>
            <th>@T[DeanAccountTextKeys.ColumnState]</th>
            <th>@T[DeanAccountTextKeys.ColumnTemporary]</th>
            <th>@T[DeanAccountTextKeys.ColumnLastSignIn]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dean in Model.Deans)
        {
            <tr class="dean-account" data-dean-id="@dean.Id" data-state="@(dean.IsDisabled ? "Disabled" : "Active")">
                <td class="dean-email">@dean.Email</td>
                <td class="dean-state">@T[dean.IsDisabled ? DeanAccountTextKeys.StateDisabled : DeanAccountTextKeys.StateActive]</td>
                <td class="dean-temporary">@(dean.PasswordIsTemporary ? "+" : "—")</td>
                <td class="dean-last-sign-in">@(dean.LastSuccessfulSignInAt?.UtcDateTime.ToString("d", System.Globalization.CultureInfo.CurrentCulture) ?? "—")</td>
                <td>
                    <form method="post" action="/settings/deans/@dean.Id/state">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="desiredState" value="@(dean.IsDisabled ? "Active" : "Disabled")" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@T[dean.IsDisabled ? DeanAccountTextKeys.ActionReEnable : DeanAccountTextKeys.ActionDisable]</button>
                    </form>
                    <form method="post" action="/settings/deans/@dean.Id/password">
                        @Html.AntiForgeryToken()
                        <label class="form-label">
                            @T[DeanAccountTextKeys.CreatePasswordLabel]
                            <span class="password-field">
                                <input type="password" name="temporaryPassword" autocomplete="new-password" spellcheck="false" autocapitalize="off" class="form-control" />
                                @await Html.PartialAsync("_PasswordToggle")
                            </span>
                        </label>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@T[DeanAccountTextKeys.ActionResetPassword]</button>
                    </form>
                    <form method="post" action="/settings/deans/@dean.Id/login">
                        @Html.AntiForgeryToken()
                        <label class="form-label">
                            @T[DeanAccountTextKeys.ChangeLoginEmailLabel]
                            <input type="email" name="newEmail" autocomplete="off" class="form-control" />
                        </label>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@T[DeanAccountTextKeys.ActionChangeLogin]</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<form method="post" action="/settings/deans" id="create-dean">
    @Html.AntiForgeryToken()
    <label class="form-label">
        @T[DeanAccountTextKeys.CreateEmailLabel]
        <input type="email" name="email" value="@Model.EmailInput" autocomplete="off" class="form-control" />
    </label>
    <label class="form-label">
        @T[DeanAccountTextKeys.CreatePasswordLabel]
        <span class="password-field">
            <input type="password" name="temporaryPassword" autocomplete="new-password" spellcheck="false" autocapitalize="off" class="form-control" />
            @await Html.PartialAsync("_PasswordToggle")
        </span>
    </label>
    <button type="submit" class="btn btn-primary">@T[DeanAccountTextKeys.CreateSubmit]</button>
</form>

<script src="/js/password-toggle.js" defer></script>

@functions {
    private static string ReasonKey(LegitimacyModeReason? reason) => reason switch
    {
        LegitimacyModeReason.SuspendedByOwner => "Landing.ReadOnly.SuspendedByOwner",
        LegitimacyModeReason.GracePeriodExpired => "Landing.ReadOnly.GracePeriodExpired",
        _ => "Landing.ReadOnly.NotYetConfirmed",
    };
}
