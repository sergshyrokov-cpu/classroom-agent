@model ChangePasswordPageModel
@{
    ViewData["Title"] = T[DeanAccountTextKeys.OwnPasswordTitle];
}

@if (Model.MessageKey is not null)
{
    <p class="form-message">@T[Model.MessageKey]</p>
}

<form method="post" action="/account/password" id="own-password">
    @Html.AntiForgeryToken()
    <label class="form-label">
        @T[DeanAccountTextKeys.OwnPasswordCurrentLabel]
        <span class="password-field">
            <input type="password" name="currentPassword" autocomplete="current-password" spellcheck="false" autocapitalize="off" class="form-control" />
            @await Html.PartialAsync("_PasswordToggle")
        </span>
    </label>
    <label class="form-label">
        @T[DeanAccountTextKeys.OwnPasswordNewLabel]
        <span class="password-field">
            <input type="password" name="newPassword" autocomplete="new-password" spellcheck="false" autocapitalize="off" class="form-control" />
            @await Html.PartialAsync("_PasswordToggle")
        </span>
    </label>
    <button type="submit" class="btn btn-primary">@T[DeanAccountTextKeys.OwnPasswordSubmit]</button>
</form>
<script src="/js/password-toggle.js" asp-append-version="true" defer></script>
