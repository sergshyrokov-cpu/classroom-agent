@model ChangePasswordPageModel
@{
    ViewData["Title"] = T[DeanAccountTextKeys.ForcedChangeTitle];
}

<p>@T[DeanAccountTextKeys.ForcedChangeExplanation]</p>

@if (Model.MessageKey is not null)
{
    <p class="form-message">@T[Model.MessageKey]</p>
}

<form method="post" action="/sign-in/change-password" id="forced-password-change">
    @Html.AntiForgeryToken()
    <label class="form-label">
        @T[DeanAccountTextKeys.OwnPasswordNewLabel]
        <span class="password-field">
            <input type="password" name="newPassword" autocomplete="new-password" spellcheck="false" autocapitalize="off" class="form-control" />
            @await Html.PartialAsync("_PasswordToggle")
        </span>
    </label>
    <button type="submit" class="btn btn-primary">@T[DeanAccountTextKeys.OwnPasswordSubmit]</button>
</form>
<script src="/js/password-toggle.js" defer></script>
