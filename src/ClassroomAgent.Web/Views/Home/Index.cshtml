@model LandingPageModel
@{
    ViewData["Title"] = T["Landing.Title"];
}
<p>@T["Landing.SignedInAs"] <span id="signed-in-email">@Model.Email</span></p>
<p id="signed-in-role">@T[Model.RoleKey]</p>

@if (Model.IsReadOnly)
{
    <section class="notice">
        <h2>@T["Landing.ReadOnly.Title"]</h2>
        <p>@T[ReasonKey(Model.ReadOnlyReason)]</p>
        @if (Model.LastSuccessfulCheckAt is { } checkedAt)
        {
            <p>@T["Landing.ReadOnly.LastSuccessfulCheck"]: @checkedAt.UtcDateTime.ToString(System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern + " HH:mm", System.Globalization.CultureInfo.CurrentCulture) UTC</p>
        }
    </section>
}
else
{
    <p>@T["Landing.Legitimacy.Ok"]</p>
}

@if (Model.CanRequestSynchronization)
{
    @* US-019 spec FR-004: the Dean's button; shown in read-only mode too (OD-006), nothing about any run (S-08). *@
    if (Model.SynchronizationMessageKey is { } synchronizationMessage)
    {
        <p id="synchronization-request-message" class="form-message">@T[synchronizationMessage]</p>
    }
    <form id="synchronization-request-form" method="post" action="@SignInRoutes.SynchronizationRequests">
        @Html.AntiForgeryToken()
        <button type="submit">@T[SynchronizationRequestTextKeys.Button]</button>
    </form>
}

@* US-025 spec FR-011: the Google Workspace section (trebovaniya.md v83), for Admin and Dean, in read-only mode too.
   A plain link, not enforcement — the ViewJournal policy is. *@
<nav id="workspace-section">
    <h2>@T[JournalTextKeys.WorkspaceSection]</h2>
    <a href="@SignInRoutes.Journal">@T[JournalTextKeys.NavigationEntry]</a>
</nav>

@* US-027 spec FR-001: the Reports and templates section, for Admin and Dean, in read-only mode too. A plain link, not
   enforcement — the UseReportTemplates and EditReportTemplates policies are. *@
<nav id="report-templates-section">
    <h2>@T[ReportTemplateTextKeys.Section]</h2>
    <a href="@SignInRoutes.ReportTemplates">@T[ReportTemplateTextKeys.NavigationEntry]</a>
</nav>

@if (User.IsInRole("Admin"))
{
    <nav id="admin-settings">
        <a href="@SignInRoutes.WorkspaceConnection">@T[WorkspaceConnectionTextKeys.NavigationEntry]</a>
        <a href="@SignInRoutes.ConnectionInstruction">@T[ConnectionInstructionTextKeys.NavigationEntry]</a>
        <a href="@SignInRoutes.AccessCheck">@T[AccessCheckTextKeys.NavigationEntry]</a>
    </nav>
}

<form method="post" action="@SignInRoutes.SignOut">
    @Html.AntiForgeryToken()
    <button type="submit">@T["Landing.SignOut"]</button>
</form>

@functions {
    private static string ReasonKey(LegitimacyModeReason? reason) => reason switch
    {
        LegitimacyModeReason.NotYetConfirmed => "Landing.ReadOnly.NotYetConfirmed",
        LegitimacyModeReason.SuspendedByOwner => "Landing.ReadOnly.SuspendedByOwner",
        LegitimacyModeReason.GracePeriodExpired => "Landing.ReadOnly.GracePeriodExpired",
        _ => "Landing.ReadOnly.Title",
    };
}
