@using System.Globalization
@using ClassroomAgent.Application.Models.Dtos
@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery
@model MeetReportsPageModel
@{
    ViewData["Title"] = T[MeetReportsTextKeys.Title];
    ViewData[PageHelpTextKeys.ViewDataKey] = PageHelpTextKeys.MeetReports; // US-076 FR-004: this page carries the help

    // Spec VR-004: the language switcher returns to the effective query — never the raw one, so a malformed value or an
    // unknown parameter is not echoed.
    ViewData[UiLanguageController.ReturnPathViewDataKey] = ReportsUrl();
    var culture = CultureInfo.CurrentCulture;
}

@await Html.PartialAsync("_PageSearchHint", PageSearchHintTextKeys.Ordinary)

@* Spec FR-013: every message the query found, in parameter order; a malformed value is never echoed. *@
@foreach (var message in Model.MessageKeys)
{
    <p class="form-error">@T[MeetReportsTextKeys.Validation(message)]</p>
}

@* api-design §2.1: the form submits to this page by GET, so a report is a bookmarkable URL. The query string carries
   the internal course id and two dates — no personal data (spec §7). *@
<form id="meet-reports-form" method="get" action="@SignInRoutes.MeetReports">
    @if (Model.NoCoursesStored)
    {
        <p>@T[MeetReportsTextKeys.NoCourses]</p>
    }
    else
    {
        <p>
            <label for="meet-reports-course" class="form-label">@T[MeetReportsTextKeys.FormCourse]</label>
            <select id="meet-reports-course" name="@MeetReportsController.CourseIdParameter" class="form-select" data-narrow="select" data-narrow-label="@T[PickerTextKeys.Label]" data-narrow-none="@T[PickerTextKeys.NothingFound]">
                <option value="">@T[JournalTextKeys.ChooseCourse]</option>
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.Id.ToString(CultureInfo.InvariantCulture)" selected="@(course.Id == Model.SelectedCourseId)">@CourseLabel(course)</option>
                }
            </select>
        </p>
    }
    <p>
        <label for="meet-reports-from" class="form-label">@T[MeetReportsTextKeys.FormFrom]</label>
        <input id="meet-reports-from" type="date" name="@MeetReportsController.FromParameter" value="@IsoDate(Model.From)" class="form-control" />
        <label for="meet-reports-to" class="form-label">@T[MeetReportsTextKeys.FormTo]</label>
        <input id="meet-reports-to" type="date" name="@MeetReportsController.ToParameter" value="@IsoDate(Model.To)" class="form-control" />
    </p>
    <button type="submit" class="btn btn-primary">@T[MeetReportsTextKeys.FormSubmit]</button>
</form>
@if (!Model.NoCoursesStored)
{
    <script src="~/js/picker-narrow.js" asp-append-version="true"></script>
}

@if (Model.Reports is { } reports)
{
    @* US-061 spec FR-005: a marked course's roster is frozen at its last read; one restrained line, nothing else changes. *@
    @if (reports.CourseNotice is { } courseNotice)
    {
        <p id="meet-reports-course-notice">@DataMarksTexts.MeetNotice(T, courseNotice)</p>
    }

    @* Spec FR-012: Meet data arrive late; the time Meet meetings are loaded up to, in the school's zone. *@
    <p id="meet-reports-delay-notice">
        @T[MeetReportsTextKeys.DelayNotice]
        @if (reports.DelayNotice.MeetLoadedUpTo is { } loadedUpTo)
        {
            <span>@T[MeetReportsTextKeys.DelayNoticeLoadedUpTo] @loadedUpTo.ToString(culture.DateTimeFormat.ShortDatePattern + " HH:mm", culture)</span>
        }
        else
        {
            <span>@T[MeetReportsTextKeys.DelayNoticeNotLoaded]</span>
        }
    </p>

    @* US-044: the action carries validated values only; a static script posts them as JSON with the antiforgery
       header. No form submission, no inline script. *@
    @if (Model.Export is { } export)
    {
        <section id="meet-export">
            <meta name="request-verification-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
            <fieldset>
                <legend>@T[JournalExportTextKeys.OrientationCaption]</legend>
                <label class="form-check"><input type="radio" name="orientation" value="portrait" class="form-check-input" /> @T[JournalExportTextKeys.OrientationPortrait]</label>
                <label class="form-check"><input type="radio" name="orientation" value="landscape" checked="checked" class="form-check-input" /> @T[JournalExportTextKeys.OrientationLandscape]</label>
            </fieldset>
            <button type="button" id="meet-export-button"
                    data-kind="reports"
                    data-course-id="@export.CourseId.ToString(CultureInfo.InvariantCulture)"
                    data-from="@export.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                    data-to="@export.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="btn btn-outline-secondary">@T[JournalExportTextKeys.Action]</button>
            <p id="meet-export-error" class="form-error" aria-live="polite"></p>
        </section>
        <script src="~/js/meet-export.js" asp-append-version="true"></script>
    }

    @* Report 1 (spec FR-007, I-6). *@
    <section id="meet-reports-summary">
        <h2>@T[MeetReportsTextKeys.SummaryTitle]</h2>
        <dl>
            <dt>@T[MeetReportsTextKeys.SummaryMeetingCount]</dt>
            <dd>@reports.Summary.MeetingCount.ToString(culture)</dd>
            <dt>@T[MeetReportsTextKeys.SummaryTotalDuration]</dt>
            <dd>@HoursAndMinutes(reports.Summary.TotalDurationSeconds)</dd>
            <dt>@T[MeetReportsTextKeys.SummaryAverageDuration]</dt>
            <dd>@Minutes(reports.Summary.AverageDurationSeconds)</dd>
            <dt>@T[MeetReportsTextKeys.SummaryAverageStudents]</dt>
            <dd>@reports.Summary.AverageStudentsPerMeeting.ToString("0.0", culture)</dd>
        </dl>
    </section>

    @* Report 2 (spec FR-008): one row per Google meeting, each linking to report 4; rendered whole (I-9). *@
    <section id="meet-reports-meetings">
        <h2>@T[MeetReportsTextKeys.MeetingsTitle]</h2>
        @if (reports.Meetings.Count == 0)
        {
            <p>@T[MeetReportsTextKeys.EmptyNoMeetings]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsDate]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsStart]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsEnd]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsDuration]</th>
                            <th scope="col">@T[MeetReportsTextKeys.MeetingsOrganizer]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsCourseTeachers]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsCourseStudents]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsNotOnCourseList]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.MeetingsOtherParticipants]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in reports.Meetings)
                        {
                            <tr>
                                <td class="text-end"><a href="@MeetingUrl(row.MeetingId)">@row.StartedAt.ToString("d", culture)</a></td>
                                <td class="text-end">@row.StartedAt.ToString("HH:mm", culture)</td>
                                <td class="text-end">@(row.EndedAt.Date == row.StartedAt.Date ? row.EndedAt.ToString("HH:mm", culture) : row.EndedAt.ToString("d", culture) + " " + row.EndedAt.ToString("HH:mm", culture))</td>
                                <td class="text-end">@Minutes(row.DurationSeconds)</td>
                                <td>
                                    @await Html.PartialAsync("_MeetPerson", row.Organizer)
                                    @if (row.OrganizerNotCourseTeacher)
                                    {
                                        <br /><span>@T[MeetReportsTextKeys.MarkNotCourseTeacher]</span>
                                    }
                                </td>
                                <td class="text-end">@row.CourseTeachers.ToString(culture)</td>
                                <td class="text-end">@row.CourseStudents.ToString(culture)</td>
                                <td class="text-end">@row.NotOnCourseList.ToString(culture)</td>
                                <td class="text-end">@row.OtherParticipants.ToString(culture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* Report 3 (spec FR-009): the students of the period, by name; rendered whole. *@
    <section id="meet-reports-students">
        <h2>@T[MeetReportsTextKeys.StudentsTitle]</h2>
        @if (reports.Students.Count == 0)
        {
            <p>@T[MeetReportsTextKeys.EmptyNoStudents]</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">@T[MeetReportsTextKeys.StudentsStudent]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.StudentsMeetings]</th>
                            <th scope="col" class="text-end">@T[MeetReportsTextKeys.StudentsMinutes]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in reports.Students)
                        {
                            <tr>
                                <th scope="row">@await Html.PartialAsync("_MeetPerson", row.Student)</th>
                                <td class="text-end">@row.Meetings.ToString(culture)</td>
                                <td class="text-end">@Minutes(row.TotalSeconds)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@functions {
    /// <summary>The course name, then its section when it has one; Google data, not translated.</summary>
    private static string CourseLabel(CourseOption course) =>
        string.IsNullOrEmpty(course.Section) ? course.Name : course.Name + " — " + course.Section;

    /// <summary>The value an HTML date input expects; empty when the date is unknown or was malformed.</summary>
    private static string IsoDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? string.Empty;

    /// <summary>Spec I-5: seconds as whole minutes, half up.</summary>
    private static string Minutes(long seconds) =>
        ((seconds + 30) / 60).ToString(CultureInfo.CurrentCulture);

    /// <summary>Spec I-6: the total duration as hours and minutes.</summary>
    private static string HoursAndMinutes(long seconds)
    {
        var minutes = (seconds + 30) / 60;
        return (minutes / 60).ToString(CultureInfo.CurrentCulture) + ":" + (minutes % 60).ToString("00", CultureInfo.CurrentCulture);
    }

    /// <summary>The effective query of this page: the validated course id and dates only.</summary>
    private string Query()
    {
        var parts = new List<string>();
        if (Model.SelectedCourseId is { } courseId)
        {
            parts.Add(MeetReportsController.CourseIdParameter + "=" + courseId.ToString(CultureInfo.InvariantCulture));
        }

        if (Model.From is not null)
        {
            parts.Add(MeetReportsController.FromParameter + "=" + IsoDate(Model.From));
        }

        if (Model.To is not null)
        {
            parts.Add(MeetReportsController.ToParameter + "=" + IsoDate(Model.To));
        }

        return parts.Count == 0 ? string.Empty : "?" + string.Join('&', parts);
    }

    private string ReportsUrl() => SignInRoutes.MeetReports + Query();

    /// <summary>Spec FR-008: report 4 of the meeting, with the course and the period it was opened from.</summary>
    private string MeetingUrl(long meetingId) =>
        SignInRoutes.MeetReports + "/meetings/" + meetingId.ToString(CultureInfo.InvariantCulture) + Query();
}
