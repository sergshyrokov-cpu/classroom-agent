@using ClassroomAgent.Application.Models
@using ClassroomAgent.Application.Models.Dtos
@model ErasurePageModel
@{
    ViewData["Title"] = T[ErasureTextKeys.Title];
}

<h1>@T[ErasureTextKeys.Title]</h1>

@if (Model.ReadOnlyNotice)
{
    <p class="notice" id="erasure-read-only-notice">@T[ErasureTextKeys.ReadOnlyNotice]</p>
}

@if (Model.MessageKey is { } message)
{
    <p class="form-message" id="erasure-message">@T[ErasureTextKeys.Of(message)]</p>
}

<form method="post" action="@SignInRoutes.ErasureSearches" id="erasure-search-form">
    @Html.AntiForgeryToken()
    <label>
        @T[ErasureTextKeys.SearchLabel]
        <input type="search" name="term" value="@Model.Search.Term" maxlength="254" autocomplete="off" />
    </label>
    <button type="submit">@T[ErasureTextKeys.SearchButton]</button>
    @if (Model.Search.FieldError is { } searchError)
    {
        <p class="field-error" id="erasure-search-error">@T[ErasureTextKeys.Of(searchError)]</p>
    }
</form>

@if (Model.Search.Performed)
{
    @if (Model.Search.Results.Count == 0)
    {
        <p id="erasure-none-found">@T[ErasureTextKeys.NoneFound]</p>
    }
    else
    {
        <ul id="erasure-results">
            @foreach (var result in Model.Search.Results)
            {
                <li data-participant-id="@result.ParticipantId">
                    <a href="@SignInRoutes.ErasureConfirmationOf(result.ParticipantId)">@(string.IsNullOrWhiteSpace(result.FullName) ? T[ErasureTextKeys.NoName].Value : result.FullName)</a>
                    <span>@(result.Email ?? T[ErasureTextKeys.NoEmail].Value)</span>
                    <span>@T[ErasureTextKeys.TeacherCourses]: @result.TeacherCourses</span>
                    <span>@T[ErasureTextKeys.StudentCourses]: @result.StudentCourses</span>
                </li>
            }
        </ul>
        @if (Model.Search.Truncated)
        {
            <p id="erasure-truncated">@T[ErasureTextKeys.Truncated]</p>
        }
    }
}

<h2>@T[ErasureTextKeys.LiftTitle]</h2>
<form method="post" action="@SignInRoutes.ErasureLiftings" id="erasure-lift-form">
    @Html.AntiForgeryToken()
    <label>
        @T[ErasureTextKeys.LiftLabel]
        <input type="text" name="email" value="@Model.Lift.Email" maxlength="254" autocomplete="off" />
    </label>
    <button type="submit" disabled="@(Model.ReadOnlyNotice ? "disabled" : null)">@T[ErasureTextKeys.LiftButton]</button>
    @if (Model.Lift.FieldError is { } liftError)
    {
        <p class="field-error" id="erasure-lift-error">@T[ErasureTextKeys.Of(liftError)]</p>
    }
    @if (Model.Lift.NoExclusionForEmail)
    {
        <p id="erasure-no-exclusion">@T[ErasureTextKeys.NoExclusion]</p>
    }
</form>

<h2>@T[ErasureTextKeys.EnterTitle]</h2>
<p>@T[ErasureTextKeys.EnterExplanation]</p>
<form method="post" action="@SignInRoutes.ErasureExclusions" id="erasure-enter-form">
    @Html.AntiForgeryToken()
    <label>
        @T[ErasureTextKeys.EnterLabel]
        <input type="text" name="email" value="@Model.Enter.Email" maxlength="254" autocomplete="off" />
    </label>
    <button type="submit" disabled="@(Model.ReadOnlyNotice ? "disabled" : null)">@T[ErasureTextKeys.EnterButton]</button>
    @if (Model.Enter.FieldError is { } enterError)
    {
        <p class="field-error" id="erasure-enter-error">@T[ErasureTextKeys.Of(enterError)]</p>
    }
</form>

@if (Model.Enter.Outcome == ExclusionEntryOutcome.AlreadyExcluded)
{
    <p id="erasure-already-excluded">@T[ErasureTextKeys.AlreadyExcluded]</p>
}

@if (Model.Enter.Outcome == ExclusionEntryOutcome.AlreadyLoaded)
{
    <p id="erasure-already-loaded">@T[ErasureTextKeys.AlreadyLoaded]</p>
    <ul id="erasure-loaded-results">
        @foreach (var result in Model.Enter.LoadedParticipants)
        {
            <li data-participant-id="@result.ParticipantId">
                <a href="@SignInRoutes.ErasureConfirmationOf(result.ParticipantId)">@(string.IsNullOrWhiteSpace(result.FullName) ? T[ErasureTextKeys.NoName].Value : result.FullName)</a>
                <span>@(result.Email ?? T[ErasureTextKeys.NoEmail].Value)</span>
                <span>@T[ErasureTextKeys.TeacherCourses]: @result.TeacherCourses</span>
                <span>@T[ErasureTextKeys.StudentCourses]: @result.StudentCourses</span>
            </li>
        }
    </ul>
    @if (Model.Enter.LoadedTruncated)
    {
        <p id="erasure-loaded-truncated">@T[ErasureTextKeys.LoadedTruncated]</p>
    }
}
