@model SignInPageModel
@{
    ViewData["Title"] = T["SignIn.Title"];
}
@if (Model.Refused)
{
    <p class="form-error">@T["SignIn.Refused"]</p>
}
<form method="post" action="/sign-in">
    @Html.AntiForgeryToken()
    <label for="login" class="form-label">@T["SignIn.Login.Label"]</label>
    <input id="login" name="login" type="text" value="@Model.Login" class="form-control" />
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "login")

    <label for="password" class="form-label">@T["SignIn.Password.Label"]</label>
    <span class="password-field">
        <input id="password" name="password" type="password" value="" spellcheck="false" autocapitalize="off" class="form-control" />
        @await Html.PartialAsync("~/Views/Shared/_PasswordToggle.cshtml")
    </span>
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "password")

    <button type="submit" class="btn btn-primary">@T["SignIn.Submit"]</button>
</form>
<script src="/js/password-toggle.js" asp-append-version="true" defer></script>
