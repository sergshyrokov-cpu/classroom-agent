@using ClassroomAgent.ControlPlane.Controllers
@using ClassroomAgent.ControlPlane.Services
@model InstallationStatusConfirmationPageModel
@{
    ViewData["Title"] = T[Model.KeyPrefix + ".Title"];
}
<dl>
    <dt>@T["Installation.Name.Label"]</dt>
    <dd>@Model.Installation.Name</dd>

    <dt>@T["Installation.Domain.Label"]</dt>
    <dd>@Model.Installation.Domain</dd>
</dl>
<p class="note">@T[Model.KeyPrefix + ".Explanation"]</p>
<form method="post" action="@Model.ActionPath">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn @(Model.Transition == InstallationStatusTransition.Suspend ? "btn-outline-danger" : "btn-primary")">@T[Model.KeyPrefix + ".Confirm"]</button>
</form>
<p><a href="@Model.DetailPath">@T[Model.KeyPrefix + ".Cancel"]</a></p>
