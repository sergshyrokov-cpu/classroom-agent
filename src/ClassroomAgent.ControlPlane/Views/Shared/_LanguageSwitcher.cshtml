@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@*
    US-039 header switcher (spec FR-002, openapi x-ui-elements LanguageSwitcher): rendered only on a page whose
    endpoint requires sign-in, so the sign-in pages and the first-run setup — SC-4's anonymous list — never show
    it, and never on the error page under any endpoint (OD-002, I-5; US-072 FR-002). The endpoint cannot tell an
    error page, because ErrorController.Page answers under the protected endpoint that failed; every path to that
    page uses its model, so no caller has to remember a flag. One plain POST form per offered language, no
    JavaScript; the current language is marked, not a submit. Built from the request, never from an entity (AD-8).
*@
@{
    var requiresSignIn = Context.GetEndpoint()?.Metadata.GetMetadata<IAllowAnonymous>() is null;
    var isErrorPage = ViewData.Model is ErrorPageModel;
    if (User.Identity?.IsAuthenticated == true && requiresSignIn && !isErrorPage)
    {
        var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var returnPath = Context.Request.Path.Value + Context.Request.QueryString.Value;
        (string Code, string Key)[] languages = [("uk", "Layout.Language.Uk"), ("en", "Layout.Language.En")];

        <nav class="language-switcher" aria-label="@T["Layout.Language.Switcher"]">
            @foreach (var (code, key) in languages)
            {
                if (code == current)
                {
                    <span lang="@code" aria-current="true" class="btn btn-sm btn-secondary active">@T[key]</span>
                }
                else
                {
                    <form method="post" action="/account/language">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="language" value="@code" />
                        <input type="hidden" name="returnPath" value="@returnPath" />
                        <button type="submit" lang="@code" class="btn btn-sm btn-outline-secondary">@T[key]</button>
                    </form>
                }
            }
        </nav>
    }
}
