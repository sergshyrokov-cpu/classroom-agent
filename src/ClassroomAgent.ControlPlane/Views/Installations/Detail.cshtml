@using ClassroomAgent.ControlPlane.Controllers
@using ClassroomAgent.ControlPlane.Persistence
@model InstallationDetailPageModel
@{
    var installation = Model.Installation;
    ViewData["Title"] = T["Installation.Detail.Title"];
    var detailPath = "/installations/" + installation.Identifier.ToString("D");
}
<dl>
    <dt>@T["Installation.Identifier.Label"]</dt>
    <dd>
        <code id="installation-identifier">@installation.Identifier.ToString("D")</code>
        <button type="button" data-copy-target="installation-identifier" data-copied-text="@T["Installation.Identifier.Copied"]">@T["Installation.Identifier.Copy"]</button>
        <span class="copy-status" data-copy-status="installation-identifier"></span>
        <p class="note">@T["Installation.Identifier.ConfigurationNote"]</p>
    </dd>

    <dt>@T["Installation.Name.Label"]</dt>
    <dd>@installation.Name</dd>

    <dt>@T["Installation.Domain.Label"]</dt>
    <dd>@installation.Domain</dd>

    <dt>@T["Installation.Status.Label"]</dt>
    <dd>
        @T[InstallationDisplay.StatusKey(installation.Status)]
        @if (installation.Status == InstallationStatus.Active)
        {
            <span id="installation-suspend"><a href="@(detailPath + "/suspension")">@T["Installation.Suspend"]</a></span>
        }
        else
        {
            <span id="installation-resume"><a href="@(detailPath + "/resumption")">@T["Installation.Resume"]</a></span>
        }
        @if (Model.NoticeKey is { } noticeKey)
        {
            <p class="note" id="installation-status-notice">@T[noticeKey]</p>
        }
    </dd>

    <dt>@T["Installation.CreatedAt.Label"]</dt>
    <dd>@InstallationDisplay.UtcTime(installation.CreatedAt)</dd>

    <dt>@T["Installation.ClientId.Label"]</dt>
    <dd>@installation.ClientId</dd>
</dl>
<section>
    <h2>@T["AllowedAdmins.Title"]</h2>
    @if (installation.Admins.Count < 2)
    {
        <p class="warning" id="allowed-admins-warning">@T["AllowedAdmins.FewerThanTwoWarning"]</p>
    }
    @if (installation.Admins.Count == 0)
    {
        <p>@T["AllowedAdmins.Empty"]</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>@T["AllowedAdmin.Email.Label"]</th>
                    <th>@T["AllowedAdmin.AddedAt.Label"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in installation.Admins)
                {
                    <tr>
                        <td>@admin.Email</td>
                        <td>@InstallationDisplay.UtcTime(admin.AddedAt)</td>
                        <td><a href="@(detailPath + "/admins/" + admin.Identifier.ToString("D") + "/revocation")">@T["AllowedAdmin.Revoke"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p><a href="@(detailPath + "/admins/new")">@T["AllowedAdmins.Add"]</a></p>
</section>
<p><a href="@(detailPath + "/name")">@T["Installation.Rename.Link"]</a></p>
<p><a href="@(detailPath + "/client-id")">@T["Installation.ChangeClientId.Link"]</a></p>
<p><a href="/installations">@T["Installation.BackToList"]</a></p>
<script src="/js/copy-identifier.js" defer></script>
