@model RegisterInstallationPageModel
@{
    ViewData["Title"] = T["Installation.New.Title"];
}
<form method="post" action="/installations" autocomplete="off">
    @Html.AntiForgeryToken()
    <label for="name" class="form-label">@T["Installation.Name.Label"]</label>
    <input id="name" name="name" type="text" value="@Model.Name" class="form-control" />
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "name")

    <label for="domain" class="form-label">@T["Installation.Domain.Label"]</label>
    <input id="domain" name="domain" type="text" value="@Model.Domain" class="form-control" />
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "domain")

    <label for="clientId" class="form-label">@T["Installation.ClientId.Label"]</label>
    <input id="clientId" name="clientId" type="text" inputmode="numeric" value="@Model.ClientId" class="form-control" />
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "clientId")

    <label for="pushAddress" class="form-label">@T["Installation.PushAddress.Label"]</label>
    <input id="pushAddress" name="pushAddress" type="text" value="@Model.PushAddress" class="form-control" />
    @await Html.PartialAsync("~/Views/Shared/_FieldErrors.cshtml", "pushAddress")

    <button type="submit" class="btn btn-primary">@T["Installation.New.Submit"]</button>
</form>
<p><a href="/installations">@T["Installation.BackToList"]</a></p>
